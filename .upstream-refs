# LARGE FORMAT — Paperclip upstream pin (single source of truth)
# Adopted per LAR-621: carry local edits as numbered patches on a PINNED upstream base.
# THE PIN is the resolved SHA below — never the tag string (a commit may carry >1 tag).
# Re-pinned LAR-625 (2026-07-21): fork -> pinned OFFICIAL release v2026.720.0.
UPSTREAM_REMOTE=origin
UPSTREAM_REMOTE_URL=https://github.com/paperclipai/paperclip.git
UPSTREAM_RELEASE_TAG=v2026.720.0                                   # release tag (points EXACTLY at the pin)
UPSTREAM_PIN_SHA=903bd157c22a39c1b90813b8d2a7e63cfd10fa65         # THE PIN (resolved SHA)
UPSTREAM_PIN_DESCRIBE_RELEASE=v2026.720.0                         # git describe --match 'v*' (exact tag, 0 commits past)
UPSTREAM_PIN_DESCRIBE_CANARY=canary/v2026.720.0-canary.0         # same commit, canary tag string (why we pin by SHA)
